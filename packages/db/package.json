    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.10.5",
    "prisma": "^6.19.3",
    "rimraf": "^6.0.1",
    "typescript": "5.5.4"
  },
  "keywords": [],
  "author": "",
