# Postgres connection string (same value as packages/db/.env)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/excalidraw?schema=public"

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production - the server refuses to start without it.
JWT_SECRET=""

# How long issued tokens stay valid.
JWT_EXPIRES_IN="7d"

# Port to listen on. Most hosts inject PORT automatically.
PORT=3001

# Comma separated list of browser origins allowed to call this API.
# Use "*" for local development only.
ALLOWED_ORIGINS="http://localhost:3000"
